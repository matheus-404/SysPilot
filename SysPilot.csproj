<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>Assets\Icons\SysPilot.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia UI core packages -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- Svg control compatible with Avalonia 12.x -->
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
    <!-- CommunityToolkit MVVM para ObservableObject, RelayCommand e Injeção de Dependência -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <!-- Explicit reference to resolve vulnerable transitive dependency (GHSA-xrw6-gwf8-vvr9) -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include all icon subfolders and SVG assets -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>